{
  "rules": {
    "conversations": {
      "$convId": {
        ".read": "auth != null && data.child('participants').child(auth.uid).exists()",
        "participants": {
          ".write": "auth != null && (data.exists() ? data.child(auth.uid).exists() : newData.child(auth.uid).exists())"
        },
        "messages": {
          ".read": "auth != null && root.child('conversations/' + $convId + '/participants/' + auth.uid).exists()",
          "$messageId": {
            ".write": "auth != null && !data.exists() && newData.child('senderId').val() === auth.uid && root.child('conversations/' + $convId + '/participants/' + auth.uid).exists()"
          }
        }
      }
    },
    "userConversations": {
      "$uid": {
        "$otherUid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && (auth.uid === $uid || auth.uid === $otherUid)"
        }
      }
    }
  }
}
