{
  "rules": {
    "presence": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (root.child('userConversations/' + auth.uid + '/' + $uid).exists() && !root.child('conversations/' + auth.uid + '_' + $uid + '/blocked/' + auth.uid).exists() && !root.child('conversations/' + $uid + '_' + auth.uid + '/blocked/' + auth.uid).exists()))",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['state', 'lastChanged'])",
        "state": {
          ".validate": "newData.isString() && (newData.val() === 'online' || newData.val() === 'offline')"
        },
        "lastChanged": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "$other": { ".validate": false }
      }
    },

    "conversations": {
      "$convId": {
        ".read": "auth != null && $convId.matches(/^[0-9]+_[0-9]+$/) && ($convId.beginsWith(auth.uid + '_') || $convId.endsWith('_' + auth.uid))",

        "participants": {
          "$uid": {
            ".write": "auth != null && $convId.matches(/^[0-9]+_[0-9]+$/) && ($convId.beginsWith(auth.uid + '_') || $convId.endsWith('_' + auth.uid))",
            ".validate": "newData.isBoolean() && newData.val() === true && ($convId.beginsWith($uid + '_') || $convId.endsWith('_' + $uid))"
          }
        },

        "blocked": {
          "$blockedUid": {
            ".write": "auth != null && $convId.matches(/^[0-9]+_[0-9]+$/) && ($convId.beginsWith(auth.uid + '_') || $convId.endsWith('_' + auth.uid)) && auth.uid !== $blockedUid && ($convId.beginsWith($blockedUid + '_') || $convId.endsWith('_' + $blockedUid))",
            ".validate": "newData.isBoolean() && newData.val() === true"
          }
        },

        "presenceSnapshot": {
          "$blockedUid": {
            ".write": "auth != null && $convId.matches(/^[0-9]+_[0-9]+$/) && ($convId.beginsWith(auth.uid + '_') || $convId.endsWith('_' + auth.uid)) && auth.uid !== $blockedUid && ($convId.beginsWith($blockedUid + '_') || $convId.endsWith('_' + $blockedUid))",
            ".validate": "newData.hasChildren(['state', 'lastChanged'])",
            "state": {
              ".validate": "newData.isString() && (newData.val() === 'online' || newData.val() === 'offline')"
            },
            "lastChanged": {
              ".validate": "newData.isNumber() && newData.val() <= now + 60000"
            },
            "$other": { ".validate": false }
          }
        },

        "messages": {
          ".indexOn": ["ts"],
          "$messageId": {
            ".write": "auth != null && $convId.matches(/^[0-9]+_[0-9]+$/) && ($convId.beginsWith(auth.uid + '_') || $convId.endsWith('_' + auth.uid)) && (!data.exists() || !newData.exists())",
            ".validate": "(!data.exists() && newData.hasChildren(['senderId', 'text', 'ts']) && newData.child('senderId').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('senderId').val() === auth.uid)",
            "senderId": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 4096"
            },
            "ts": {
              ".validate": "newData.isNumber() && newData.val() <= now + 60000"
            },
            "cid": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "type": {
              ".validate": "newData.isString() && (newData.val() === 'image' || newData.val() === 'video')"
            },
            "mediaUrl": {
              ".validate": "newData.isString() && newData.val().length <= 500000"
            },
            "replyTo": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "replyText": {
              ".validate": "newData.isString() && newData.val().length <= 4096"
            },
            "replySenderName": {
              ".validate": "newData.isString() && newData.val().length <= 120"
            },
            "$other": { ".validate": false }
          }
        },

        "deletedMessages": {
          "$messageId": {
            ".write": "auth != null && $convId.matches(/^[0-9]+_[0-9]+$/) && ($convId.beginsWith(auth.uid + '_') || $convId.endsWith('_' + auth.uid)) && !data.exists() && !root.child('conversations/' + $convId + '/messages/' + $messageId).exists()",
            ".validate": "newData.hasChildren(['deletedBy', 'ts']) && newData.child('deletedBy').val() === auth.uid",
            "deletedBy": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "ts": {
              ".validate": "newData.isNumber() && newData.val() <= now + 60000"
            },
            "$other": { ".validate": false }
          }
        },

        "typing": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && $convId.matches(/^[0-9]+_[0-9]+$/) && ($convId.beginsWith(auth.uid + '_') || $convId.endsWith('_' + auth.uid))",
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          }
        },

        "reads": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && $convId.matches(/^[0-9]+_[0-9]+$/) && ($convId.beginsWith(auth.uid + '_') || $convId.endsWith('_' + auth.uid))",
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          }
        }
      }
    },

    "blocks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$otherUid": {
          ".validate": "newData.hasChildren(['at']) && newData.child('at').isNumber() && newData.child('at').val() <= now + 60000",
          "at": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "$other": { ".validate": false }
        }
      }
    },

    "userConversations": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".indexOn": ["lastAt"],

        "$otherUid": {
          ".validate": "newData.hasChildren(['convId'])",

          "convId": {
            ".write": "auth != null && (auth.uid === $uid || (auth.uid === $otherUid && !root.child('blocks/' + $uid + '/' + $otherUid).exists()))",
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]+_[0-9]+$/) && ($uid + '_' + $otherUid === newData.val() || $otherUid + '_' + $uid === newData.val())"
          },
          "otherName": {
            ".write": "auth != null && (auth.uid === $uid || (auth.uid === $otherUid && !root.child('blocks/' + $uid + '/' + $otherUid).exists()))",
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "otherPhone": {
            ".write": "auth != null && (auth.uid === $uid || (auth.uid === $otherUid && !root.child('blocks/' + $uid + '/' + $otherUid).exists()))",
            ".validate": "newData.isString() && newData.val().length <= 24"
          },
          "otherStatusText": {
            ".write": "auth != null && (auth.uid === $uid || (auth.uid === $otherUid && !root.child('blocks/' + $uid + '/' + $otherUid).exists()))",
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "isVerified": {
            ".write": "auth != null && (auth.uid === $uid || (auth.uid === $otherUid && !root.child('blocks/' + $uid + '/' + $otherUid).exists()))",
            ".validate": "newData.isBoolean()"
          },
          "isOfficial": {
            ".write": "auth != null && (auth.uid === $uid || (auth.uid === $otherUid && !root.child('blocks/' + $uid + '/' + $otherUid).exists()))",
            ".validate": "newData.isBoolean()"
          },
          "lastMessage": {
            ".write": "auth != null && (auth.uid === $uid || (auth.uid === $otherUid && !root.child('blocks/' + $uid + '/' + $otherUid).exists()))",
            ".validate": "newData.isString() && newData.val().length <= 4096"
          },
          "lastAt": {
            ".write": "auth != null && (auth.uid === $uid || (auth.uid === $otherUid && !root.child('blocks/' + $uid + '/' + $otherUid).exists()))",
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "lastSenderId": {
            ".write": "auth != null && (auth.uid === $uid || (auth.uid === $otherUid && !root.child('blocks/' + $uid + '/' + $otherUid).exists()))",
            ".validate": "newData.isString() && (newData.val() === $uid || newData.val() === $otherUid)"
          },
          "unread": {
            ".write": "auth != null && (auth.uid === $uid || (auth.uid === $otherUid && !root.child('blocks/' + $uid + '/' + $otherUid).exists()))",
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999"
          },
          "myReadAt": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
